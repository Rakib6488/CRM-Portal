# Port the server listens on (Render/most hosts set this automatically)
PORT=10000

# Comma-separated list of origins allowed to connect (your deployed portal URL, and
# http://localhost:5173 for local dev). Leave blank to allow same-host requests only.
ALLOWED_ORIGINS=http://localhost:5173

# --- Telegram --------------------------------------------------------------
# From https://my.telegram.org (API development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Generated once via a login script using the `telegram` package (StringSession)
TELEGRAM_SESSION=

# --- WhatsApp ----------------------------------------------------------------
# No env vars needed - scan the QR code shown in the portal's Live Chat panel.
# Session is cached in .wwebjs_auth/ after the first scan.

# --- Facebook Messenger ------------------------------------------------------
# 1. Create a Meta App at developers.facebook.com, add the "Messenger" product,
#    and connect your Facebook Page.
# 2. Generate a Page Access Token for that page (Messenger > Settings in the app dashboard).
FB_PAGE_ACCESS_TOKEN=
# 3. Pick any random string yourself - you'll enter this same value when you
#    configure the webhook URL in the Meta App dashboard.
FB_VERIFY_TOKEN=
# Optional - defaults to v21.0
FB_GRAPH_API_VERSION=v21.0

# --- Optional login bootstrap -----------------------------------------------
# If Firestore has no agent_credentials documents, these fallback accounts allow login.
# Override these in Render with strong, unique values before production use.
ADMIN_LOGIN_USERNAME=admin
ADMIN_LOGIN_PASSWORD=AdminSecure2026!
AGENT_LOGIN_PASSWORD=AgentPass2026!

# --- Render WhatsApp ---------------------------------------------------------
# Use `bun run build:render` as the Render build command to install Chromium.
