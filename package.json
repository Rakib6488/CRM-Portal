{
  "name": "customer-support-portal",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -n auth,chat,client -c cyan,green,magenta \"npm run dev:auth\" \"npm run dev:chat\" \"npm run dev:client\"",
    "dev:auth": "tsx server.ts",
    "dev:chat": "node server.js",
    "dev:client": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server.js"
  },
  "dependencies": {
    "@google/genai": "^1.8.0",
    "@tailwindcss/vite": "^4.1.11",
    "@twilio/voice-sdk": "^2.18.3",
    "concurrently": "^9.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.0.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.0.0",
    "firebase": "^11.1.0",
    "firebase-admin": "^13.0.0",
    "helmet": "^8.0.0",
    "input": "^1.0.1",
    "lucide-react": "^0.539.0",
    "motion": "^12.23.0",
    "mongodb": "^6.18.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.8.3",
    "telegram": "^2.22.2",
    "twilio": "^5.0.0",
    "whatsapp-web.js": "^1.26.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.11",
